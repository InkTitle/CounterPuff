<?xml version="1.0" encoding="utf-8"?>
<!--
  Optional IIS config for Windows Plesk when the site is reverse-proxied with HttpPlatformHandler.
  If you enable Node.js inside the Plesk UI, Plesk usually manages the proxy for you —
  do NOT overwrite Plesk's generated web.config unless support tells you to.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="node"
      arguments="server.js"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\node"
      startupTimeLimit="120"
      requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
